# Enabled sign-in methods: comma-separated subset of local, auth0, zitadel
# (default: local,auth0). Every enabled provider's variables below are required
# at startup; those of disabled providers can be left out.
AUTH_PROVIDERS="local,auth0"

# auth0
SOCIAL_AUTH_AUTH0_OPENIDCONNECT_DOMAIN="example.auth0.com"
SOCIAL_AUTH_AUTH0_OPENIDCONNECT_KEY="your-auth0-client-id"
SOCIAL_AUTH_AUTH0_OPENIDCONNECT_SECRET="your-auth0-client-secret"
AUTH0_ROLES_CLAIM="https://recipes.example/roles"

# zitadel (bare instance host, no https://)
# SOCIAL_AUTH_ZITADEL_DOMAIN="your-instance.zitadel.cloud"
# SOCIAL_AUTH_ZITADEL_KEY="your-zitadel-client-id"
# SOCIAL_AUTH_ZITADEL_SECRET="your-zitadel-client-secret"

SECRET_KEY = "your-django-secret-key"
POSTGRES_USER=recipes
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_DB=recipes
POSTGRES_HOST=database

# Garage S3-compatible object storage
GARAGE_ADMIN_TOKEN="your-garage-admin-token"
GARAGE_METRICS_TOKEN="your-garage-metrics-token"
GARAGE_RPC_SECRET="your-garage-rpc-secret"
S3_BUCKET_NAME="recipes-cms"
S3_ACCESS_KEY="your-garage-access-key"
S3_SECRET_KEY="your-garage-secret-key"
# Internal endpoint used by the wagtail container to upload files
S3_ENDPOINT_URL="http://s3:3900"
# Public base used by the browser to fetch media (nginx proxies /media/ → Garage web endpoint)
S3_CUSTOM_DOMAIN="localhost:8080/media"
S3_URL_PROTOCOL="http:"
S3_REGION_NAME="garage"

# Production-only settings (recipe_cms.settings.production); comma-separated lists
ALLOWED_HOSTS="localhost"
CSRF_TRUSTED_ORIGINS=""
CORS_ALLOWED_ORIGINS=""
SOCIAL_AUTH_ALLOWED_REDIRECT_HOSTS=""
# Collect static files to S3 and serve them from a CDN domain
STATIC_BUCKET_NAME=""
STATIC_CUSTOM_DOMAIN=""
POSTGRES_SSLMODE="prefer"
WAGTAILADMIN_BASE_URL="http://localhost:8080"

# Local users, created or updated on every `docker compose up` (ensure_users).
# A role is skipped when its username and password are unset. Passwords must
# pass Django's password validation. The frontend dev server (npm run dev)
# offers a username/password login for these users. Each email must differ from
# the email of any identity-provider (Auth0/Zitadel) user, or ensure_users fails
# and the stack won't start.
DJANGO_ADMIN_USERNAME="admin"
DJANGO_ADMIN_PASSWORD="change-me-admin-passphrase"
DJANGO_ADMIN_EMAIL="admin@example.com"
DJANGO_EDITOR_USERNAME="editor"
DJANGO_EDITOR_PASSWORD="change-me-editor-passphrase"
DJANGO_EDITOR_EMAIL="editor@example.com"
DJANGO_MODERATOR_USERNAME="moderator"
DJANGO_MODERATOR_PASSWORD="change-me-moderator-passphrase"
DJANGO_MODERATOR_EMAIL="moderator@example.com"

# Frontend release served at /frontend/ (default: latest, e.g. v0.5.0 to pin)
FRONTEND_VERSION=""
